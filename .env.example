# Public Supabase credentials (safe to expose in the browser)
# Copy to .env.local and fill in your project's values.
# Find them in the Supabase dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ImageKit (free image/video CDN, no credit card) — media uploads + delivery.
# Get these from https://imagekit.io/dashboard/developer/api-keys
# Run `powershell -File scripts/setup-imagekit.ps1` to capture them into .env.local.
# IMAGEKIT_PRIVATE_KEY is SERVER-ONLY — set it in Vercel → Project → Settings → Environment Variables.
IMAGEKIT_URL_ENDPOINT=your_imagekit_id
IMAGEKIT_PUBLIC_KEY=public_xxx
IMAGEKIT_PRIVATE_KEY=private_xxx
IMAGEKIT_FOLDER=portfolio
